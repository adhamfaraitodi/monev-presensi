# Secrets (Wajib diisi! Generate dengan: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=change_me_to_at_least_32_characters_random_secret_key
CRON_SECRET=change_me_to_at_least_16_chars

# Kredensial Akun Kemnaker (Untuk Cron Otomatis & pembatasan login opsional)
KEMNAKER_USERNAME=your_nik_or_email_here
KEMNAKER_PASSWORD=your_password_here
ALLOWED_USERNAME=

# Cloudflare Reverse Proxy (Opsional, jika diset maka PROXY_SECRET wajib diisi)
CLOUDFLARE_WORKER_URL=
PROXY_SECRET=

# Koordinat Lokasi Kantor Default (YIA Place Pin & Radius 10 Meter)
OFFICE_LAT=-7.9021141
OFFICE_LONG=110.065129
OFFICE_RADIUS_METERS=10
